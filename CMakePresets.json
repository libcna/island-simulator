{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "web-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-probe",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "ISLAND_BUILD_GAME": "ON",
        "ISLAND_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-consumer",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "ISLAND_BUILD_GAME": "ON",
        "ISLAND_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux OpenGL 3.3 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CNA_GRAPHICS_RENDERER": "OPENGL33",
        "ISLAND_BUILD_GAME": "ON",
        "ISLAND_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux Core AddressSanitizer and UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "ISLAND_BUILD_GAME": "OFF",
        "ISLAND_BUILD_TESTS": "ON",
        "ISLAND_BUILD_TOOLS": "ON",
        "ISLAND_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux OpenGL 3.3 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-consumer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CNA_GRAPHICS_RENDERER": "OPENGL33",
        "ISLAND_BUILD_GAME": "ON",
        "ISLAND_BUILD_TESTS": "OFF",
        "ISLAND_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "web-webgl2",
      "displayName": "Web WebGL 2 Release",
      "inherits": "web-base",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGL2"
      }
    },
    {
      "name": "android-arm64-gles3",
      "displayName": "Android arm64 OpenGL ES 3 Debug",
      "inherits": "android-base",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGLES3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "jobs": 2,
      "targets": [
        "island-simulator",
        "island_diagnostic_stream_tests",
        "island_monkey_shader_tests",
        "island_monkey_gait_tests",
        "island_audio_report",
        "island_core_tests",
        "island_flight_tests",
        "island_snake_tests",
        "island_boar_tests",
        "island_boar_coat_tests",
        "island_boar_pose_tests",
        "island_leaf_tests",
        "island_grass_blade_tests",
        "island_rendered_terrain_tests",
        "island_grass_grounding_report",
        "island_canopy_tests",
        "island_canopy_visibility_tests",
        "island_monkey_sole_tests",
        "island_terrain_material_tests",
        "island_ocean_wave_tests",
        "island_forest_floor_tests",
        "island_forest_floor_preview",
        "island_world_report"
      ]
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "jobs": 2,
      "targets": [
        "island_flight_tests",
        "island_diagnostic_stream_tests",
        "island_monkey_shader_tests",
        "island_monkey_gait_tests",
        "island_audio_report",
        "island_core_tests",
        "island_boar_tests",
        "island_snake_tests",
        "island_boar_coat_tests",
        "island_boar_pose_tests",
        "island_leaf_tests",
        "island_grass_blade_tests",
        "island_rendered_terrain_tests",
        "island_grass_grounding_report",
        "island_canopy_tests",
        "island_ocean_wave_tests",
        "island_forest_floor_tests",
        "island_forest_floor_preview",
        "island_world_report"
      ]
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 2,
      "targets": [
        "island-simulator"
      ]
    },
    {
      "name": "web-webgl2",
      "configurePreset": "web-webgl2",
      "jobs": 2,
      "targets": [
        "island-simulator"
      ]
    },
    {
      "name": "android-arm64-gles3",
      "configurePreset": "android-arm64-gles3",
      "jobs": 2,
      "targets": [
        "island-simulator"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-core",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      },
      "filter": {
        "include": {
          "name": "^Island(Core|FlightMotion|SnakePopulation|BoarHerd|BoarCoatTexture|BoarPose|LeafBlade|CanopyLightField|OceanWaveSpectrum|ForestFloorSampling)Tests$"
        }
      }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:strict_string_checks=1:check_initialization_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    }
  ]
}
